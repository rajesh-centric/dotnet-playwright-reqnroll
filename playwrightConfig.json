[
  {
    "Channel": "chrome",
    "Headless": false,
    "Args": "--start-maximized",
    "TraceOnFailure": true,
    "TracesDir": "Traces",
    "TraceFileNameFormat": "{scenario}_{timestamp}.zip",
    "ScreenshotsOnFailure": true,
    "ScreenshotDir": "Screen_shots",
    "ScreenshotFileNameFormat": "{scenario}_{timestamp}.png",
    "MaskSensitiveData": true,
    "BaseURL": "https://dummyjson.com",
    "SensitiveKeys": [ "password", "pass" ]
  }
 ]
